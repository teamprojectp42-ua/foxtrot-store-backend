    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>foxtrot_store_backend</RootNamespace>
    <UserSecretsId>23927ab3-427b-41e4-8490-cbd4a2a2f1a2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
